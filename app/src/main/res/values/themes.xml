<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Moodly" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/primary_text</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/muted</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_2</item>
    </style>

    <style name="Moodly.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_2</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Moodly.Card.Filled">
        <item name="cardBackgroundColor">@color/primary_container</item>
    </style>

    <style name="Moodly.CardTitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Moodly.Small" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Moodly.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/on_surface</item>
    </style>
    <style name="Moodly.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>
</resources>
